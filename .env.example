# ── Firebase Admin SDK (SERVER ONLY — never expose, never prefix with NEXT_PUBLIC) ──
# From Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the private key with literal \n for newlines, wrapped in quotes.
FIREBASE_ADMIN_PROJECT_ID=uizera
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@uizera.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Bootstrap super admins (comma-separated Google account emails) ──
# These accounts receive the super_admin role on first sign-in.
SUPER_ADMIN_EMAILS=uizera@psnacet.edu.in

